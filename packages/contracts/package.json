{
  "name": "@hackguard/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "HackGuard shared data contracts (Zod schemas + generated OpenAPI). Single source of truth — see plan §4.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "zod": "^3.25.67",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
