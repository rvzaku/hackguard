# HackGuard environment configuration — copy to .env and fill in.
# NEVER commit real secrets; only this .env.example is tracked.
#
# Every variable below is one the code actually reads:
# - Web (Next.js BFF): DATABASE_URL, SCORING_BASE_URL, UPSTASH_*,
#   STRIPE_WEBHOOK_SECRET  (see apps/web/src/lib/runtime.ts + webhook route)
# - Scoring sidecar: SCORING_* prefixed vars (services/scoring/src/scoring/config.py)
# Docker compose reads this file too (STRIPE_WEBHOOK_SECRET override).

# --- Database (Postgres) -----------------------------------------------------
# Optional. When set, the web app persists payments/decisions/audit/replays to
# Postgres (db/migrations are applied by docker-compose automatically). When
# unset, the app runs in in-memory demo mode (single instance, no durability).
# Local: postgresql://hackguard:hackguard@localhost:5433/hackguard
# Neon:  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/hackguard?sslmode=require
DATABASE_URL=

# --- Web (Next.js BFF) -------------------------------------------------------
# Base URL of the scoring sidecar.
SCORING_BASE_URL=http://localhost:8000

# --- Stripe (test mode ONLY — plan §8 non-goals) ------------------------------
# Signing secret of your Stripe test-mode webhook endpoint. Required for
# POST /api/webhooks/stripe (the route refuses to start ingesting without it).
STRIPE_WEBHOOK_SECRET=

# --- Upstash Redis (optional; webhook event-id idempotency) -------------------
# Without them the runtime falls back to in-memory idempotency (single-instance
# demo mode). Only read when DATABASE_URL is also set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scoring sidecar (all optional; defaults shown) ---------------------------
SCORING_ENV=development
SCORING_LOG_LEVEL=info
# Port uvicorn binds to when started via the README commands.
SCORING_PORT=8000
# Optional: the sidecar boots degraded (503 on scoring, /healthz green) if unset.
SCORING_DATABASE_URL=
# Model registry location + pinned version (defaults resolve the committed
# artifact at models/registry/propensity-v1.0.0).
# SCORING_MODEL_DIR=
# SCORING_MODEL_VERSION=propensity-v1.0.0
