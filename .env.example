# HackGuard environment configuration — copy to .env and fill in.
# NEVER commit real secrets; only this .env.example is tracked.

# --- Database (Neon Postgres free tier) -------------------------------------
# Neon connection string, e.g. postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/hackguard?sslmode=require
DATABASE_URL=

# --- Scoring sidecar (FastAPI) ----------------------------------------------
SCORING_ENV=development
SCORING_LOG_LEVEL=info
# Port the FastAPI sidecar binds to locally
SCORING_PORT=8000

# --- Web (Next.js) ----------------------------------------------------------
# Base URL of the scoring sidecar, consumed by the BFF API routes
SCORING_BASE_URL=http://localhost:8000

# --- Upstash Redis (free tier; webhook event-id idempotency) ----------------
# REST API credentials from the Upstash console. Optional: without them the
# runtime falls back to in-memory idempotency (single-instance demo mode).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (test mode ONLY — see plan §8 non-goals) ------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
